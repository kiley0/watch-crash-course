{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/course.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<courseId>[a-z0-9]+(?:-[a-z0-9]+)*)"
        }
      ],
      "destination": "/_course-:courseId.html"
    },
    {
      "source": "/watch.html",
      "has": [
        {
          "type": "query",
          "key": "course",
          "value": "(?<courseId>[a-z0-9]+(?:-[a-z0-9]+)*)"
        },
        {
          "type": "query",
          "key": "video",
          "value": "(?<videoId>[A-Za-z0-9_-]{11})"
        }
      ],
      "destination": "/_watch-:courseId-:videoId.html"
    },
    {
      "source": "/course.html",
      "destination": "/_course.html"
    },
    {
      "source": "/watch.html",
      "destination": "/_watch.html"
    }
  ]
}
